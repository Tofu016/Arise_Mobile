# Copy to .env (not committed) and set the address of Arise_API.
# EXPO_PUBLIC_ is required: Expo only inlines variables with this prefix.
#
# Local XAMPP: use this computer's LAN IP, not localhost — the phone has to
# reach it over Wi-Fi. While this is http://, app.config.js allows cleartext
# traffic in release builds; switching to https:// turns that off.
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x/Arise_API/index.php
